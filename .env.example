GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# python -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=
# Only deployment origins, no trailing slash. Local dev accepts loopback automatically.
APP_ORIGINS=
AI_ENABLED=true
# Namespace: use a separate value/database for preview and production.
REDIS_NAMESPACE=jane-prod-v1
PUBLIC_DAILY_REQUESTS=300
PUBLIC_DAILY_BUDGET_MICRO_USD=300000
PUBLIC_MONTHLY_BUDGET_MICRO_USD=9000000
# Match model pricing. $0.25/M input + $1.50/M output for Gemini 3.1 Flash-Lite.
INPUT_MICRO_USD_PER_MILLION=250000
OUTPUT_MICRO_USD_PER_MILLION=1500000
